{% extends 'base.html.twig' %}

{% block title %}{{ project.name|localized }} — PetrosLabs{% endblock %}
{% block meta_description %}{{ project.summary|localized }}{% endblock %}

{% block schema %}
    <script type="application/ld+json">
    {{ {
        '@context': 'https://schema.org',
        '@type': 'CreativeWork',
        'name': project.name|localized,
        'description': project.summary|localized,
        'url': absolute_url(path('app_project_show', {slug: project.slug})),
    }|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}
    </script>
{% endblock %}

{% block body %}
<div class="mx-auto flex min-h-screen w-full max-w-2xl flex-col px-4 pb-10 sm:px-6">

    <header class="mt-6 animate-rise sm:mt-10">
        <a href="{{ path('app_projects') }}"
           class="inline-flex items-center gap-1.5 font-mono text-xs text-parchment-dim transition-colors hover:text-teal">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
            {{ 'projects.back'|trans }}
        </a>

        <div class="mt-6 flex items-center justify-center gap-2">
            {% if project.pinned %}
                <span class="flex items-center gap-1 rounded-full border border-bronze/40 bg-charcoal/80 px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-wide text-bronze-bright">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z"/>
                    </svg>
                    {{ 'projects.pinned'|trans }}
                </span>
            {% endif %}
            {% set statusClasses = {
                'in_progress': 'border-bronze/40 text-bronze-bright',
                'done':        'border-teal/40 text-teal',
                'archived':    'border-parchment-dim/30 text-parchment-dim',
            } %}
            <span class="rounded-full border bg-charcoal/80 px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-wide {{ statusClasses[project.status] ?? statusClasses['in_progress'] }}">
                {{ ('status.' ~ project.status)|trans }}
            </span>
        </div>

        <h1 class="mt-2 text-center font-display text-3xl font-bold tracking-wide text-parchment sm:text-4xl">
            {{ project.name|localized }}
        </h1>

        {% if project.stack|length %}
            <ul class="mt-4 flex flex-wrap justify-center gap-1.5">
                {% for tech in project.stack %}
                    <li class="rounded-full border border-parchment/10 bg-charcoal/60 px-2.5 py-1 font-mono text-[0.7rem] text-parchment-dim">
                        {{ tech }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </header>

    <img src="{{ asset(project.image) }}" alt="Aperçu de {{ project.name|localized }}"
         class="mt-8 aspect-video w-full animate-rise rounded-xl border border-parchment/10 object-cover">

    {% if project.repoUrl or project.demoUrl %}
        <div class="mt-6 flex animate-rise flex-wrap items-center justify-center gap-3 font-mono text-sm">
            {% if project.repoUrl %}
                <a href="{{ project.repoUrl }}" target="_blank" rel="noopener noreferrer"
                   class="flex items-center gap-2 rounded-lg border border-teal/40 bg-teal/10 px-5 py-2.5 text-teal transition-colors hover:bg-teal/20">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                        <path d="M9 18c-4.51 2-5-2-7-2"/>
                    </svg>
                    {{ 'projects.code'|trans }}
                </a>
            {% endif %}
            {% if project.demoUrl %}
                <a href="{{ project.demoUrl }}" target="_blank" rel="noopener noreferrer"
                   class="flex items-center gap-2 rounded-lg border border-bronze/40 bg-bronze/10 px-5 py-2.5 text-bronze-bright transition-colors hover:bg-bronze/20">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7M8 7h9v9"/>
                    </svg>
                    {{ 'projects.demo'|trans }}
                </a>
            {% endif %}
        </div>
    {% endif %}

    <twig:Meander class="my-10 animate-rise sm:my-12" />

    <main class="prose-blog animate-rise leading-relaxed text-parchment-dim">
        {{ project.content|localized|markdown }}
    </main>

    <twig:Meander class="my-10 sm:my-12" />

    <twig:SiteFooter />
</div>
{% endblock %}
