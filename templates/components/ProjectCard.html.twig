{#
    Carte de projet — vitrine d'un projet avec image et stack, sans texte de
    résumé (volontaire : le détail vit sur /projects/{slug}). Toute la carte
    est un lien vers cette page détail — pas de liens Code/Démo ici non plus
    (un lien ne peut pas en contenir un autre).
    Usage :
      <twig:ProjectCard slug="..." name="..." image="..."
                        :stack="[...]" status="in_progress" :pinned="false" />
#}
{% props slug, name, image = '', stack = [], status = 'in_progress', pinned = false %}

{% set statusClasses = {
    'in_progress': 'border-bronze/40 text-bronze-bright',
    'done':        'border-teal/40 text-teal',
    'archived':    'border-parchment-dim/30 text-parchment-dim',
} %}
{% set badgeClasses = statusClasses[status] ?? statusClasses['in_progress'] %}

<a href="{{ path('app_project_show', {slug: slug}) }}"
   class="group flex h-full flex-col overflow-hidden rounded-xl border border-parchment/10 bg-charcoal-800/60 transition duration-300 ease-out hover:-translate-y-0.5 hover:border-teal/40 hover:shadow-lg hover:shadow-teal/10">
    <div class="relative">
        <img src="{{ asset(image) }}" alt="Aperçu de {{ name|localized }}"
             class="aspect-video w-full object-cover" width="800" height="450" loading="lazy">
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-charcoal-800/80 via-transparent to-transparent"></div>
        {% if pinned %}
            <span class="absolute left-3 top-3 flex items-center gap-1 rounded-full border border-bronze/40 bg-charcoal/80 px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-wide text-bronze-bright">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z"/>
                </svg>
                {{ 'projects.pinned'|trans }}
            </span>
        {% endif %}
        <span class="absolute right-3 top-3 rounded-full border bg-charcoal/80 px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-wide {{ badgeClasses }}">
            {{ ('status.' ~ status)|trans }}
        </span>
    </div>

    <div class="flex flex-1 flex-col gap-3 p-5">
        <h3 class="font-display text-lg font-semibold tracking-wide text-parchment group-hover:text-teal">{{ name|localized }}</h3>

        {% if stack|length %}
            <ul class="mt-auto flex flex-wrap gap-1.5">
                {% for tech in stack %}
                    <li class="rounded-full border border-parchment/10 bg-charcoal/60 px-2.5 py-1 font-mono text-[0.7rem] text-parchment-dim">
                        {{ tech }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</a>
