{#
    Scène d'erreur générique (404, 403, 500…), réutilisée par les templates
    sous templates/bundles/TwigBundle/Exception/.
    Usage : <twig:ErrorPage code="404" title="..." message="..." />
#}
{% props code, title, message %}
<div class="mx-auto flex min-h-screen w-full max-w-xl flex-col items-center px-4 pt-24 pb-16 text-center sm:pt-32">
    <p class="animate-rise font-display text-7xl font-bold tracking-wide text-parchment drop-shadow-[0_0_24px_rgba(192,138,62,0.35)] sm:text-8xl">
        {{ code }}
    </p>

    <twig:Meander class="my-10 w-full max-w-xs animate-rise sm:my-12" />

    <h1 class="animate-rise font-display text-2xl font-bold text-parchment sm:text-3xl">
        {{ title }}
    </h1>

    <p class="mx-auto mt-4 max-w-sm text-balance leading-relaxed text-parchment-dim">
        {{ message }}
    </p>

    <a href="{{ path('app_home') }}"
       class="mt-10 inline-flex items-center gap-2 rounded-lg border border-teal/40 bg-teal/10 px-5 py-2.5 font-mono text-sm text-teal transition-colors hover:bg-teal/20 sm:mt-12">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
        </svg>
        {{ 'error.back'|trans }}
    </a>
</div>
