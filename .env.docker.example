# Variables pour Docker Compose (compose.yaml / compose.prod.yaml) — distinct
# du .env/.env.local de Symfony. Copier vers .env.docker (non versionné) et
# renseigner le vrai domaine en production.
#
# Usage : docker compose --env-file .env.docker ...

APP_DOMAIN=petroslabs.dev

# Réseau du reverse proxy partagé que l'app rejoint (https://github.com/petroslabs/infra).
# Son dépôt crée ce réseau sous le nom `edge` — inutile de le changer, sauf
# hôte qui propose un proxy sous un autre nom.
PROXY_NETWORK=edge

# Identifiants PostgreSQL du projet (service `database`). Des valeurs
# réelles ici, jamais les défauts de dev (app/!ChangeMe!/app).
DB_USER=
DB_PASSWORD=
DB_NAME=
